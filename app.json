{
  "expo": {
    "name": "Timer",
    "slug": "timer",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/timer-app-icon-20260625.png",
    "scheme": "timer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "5",
      "bundleIdentifier": "com.qiuzizhao.timer",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Timer",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/timer-app-icon-20260625.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/timer-app-icon-20260625.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/timer-app-icon-20260625.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-notifications",
      [
        "./plugins/with-ios-pod-deployment-target",
        {
          "deploymentTarget": "15.1"
        }
      ],
      "./plugins/with-ios-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
